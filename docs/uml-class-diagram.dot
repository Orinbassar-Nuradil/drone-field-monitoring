digraph G {
rankdir=BT; nodesep=0.5; ranksep=0.8; compound=true; splines=true;
graph [fontname="Helvetica", fontsize=13, labeljust=l]; node [fontname="Helvetica", fontsize=10]; edge [fontname="Helvetica"];
subgraph cluster_mission { label="package fieldwatch.mission  (Abstraction side)"; style="rounded,dashed"; color="#888888";
FieldMission [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF4D6"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&laquo;abstract&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B><I>FieldMission</I></B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"># controller : FlightController</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+ name() : String</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ run(area : FieldArea) : MissionReport {final}</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I># planRoute(area : FieldArea) : List&lt;GeoPoint&gt;</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I># cruiseAltitudeMeters() : double</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I># atWaypoint(index : int, total : int, point : GeoPoint)</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># onAbort()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- bestEffortSafeStop()</TD></TR></TABLE>>];
MappingMission [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF4D6"><TR><TD ALIGN="CENTER"><B>MappingMission</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- CRUISE_ALTITUDE_M = 60.0</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- SWATH_M = 30.0</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ name()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># planRoute(area)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># cruiseAltitudeMeters()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># atWaypoint(index, total, point)</TD></TR></TABLE>>];
SprayingMission [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF4D6"><TR><TD ALIGN="CENTER"><B>SprayingMission</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- CRUISE_ALTITUDE_M = 4.0</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- SWATH_M = 10.0</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ name()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># planRoute(area)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># cruiseAltitudeMeters()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># atWaypoint(index, total, point)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># onAbort()</TD></TR></TABLE>>];
PerimeterPatrolMission [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF4D6"><TR><TD ALIGN="CENTER"><B>PerimeterPatrolMission</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- CRUISE_ALTITUDE_M = 40.0</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ name()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># planRoute(area)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># cruiseAltitudeMeters()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># atWaypoint(index, total, point)</TD></TR></TABLE>>];
LawnmowerPlanner [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&laquo;utility&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>LawnmowerPlanner</B></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ plan(area : FieldArea, swathMeters : double) : List&lt;GeoPoint&gt; {static}</TD></TR></TABLE>>];
MissionReport [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&laquo;record&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>MissionReport</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">missionName : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">controllerName : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">status : MissionStatus</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">waypointsReached : int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">failureReason : FailureReason</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">message : String</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ completed(...) : MissionReport {static}</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ aborted(...) : MissionReport {static}</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ isCompleted() : boolean</TD></TR></TABLE>>];
MissionStatus [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&laquo;enumeration&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>MissionStatus</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">COMPLETED</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">ABORTED</TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
}
subgraph cluster_control { label="package fieldwatch.control  (Implementor side)"; style="rounded,dashed"; color="#888888";
FlightController [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#DDEBFF"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&laquo;interface&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>FlightController</B></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ name() : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ arm()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ takeOff(altitudeMeters : double)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ goTo(target : GeoPoint, altitudeMeters : double)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ triggerPayload(command : PayloadCommand)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ returnToHome()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">(all operations: throws FlightException)</TD></TR></TABLE>>];
SimulatorFlightController [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#DDEBFF"><TR><TD ALIGN="CENTER"><B>SimulatorFlightController</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- name : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- flightLog : List&lt;String&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- armed : boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- airborne : boolean</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ name()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ flightLog() : List&lt;String&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ arm()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ takeOff(altitudeMeters)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ goTo(target, altitudeMeters)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ triggerPayload(command)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ returnToHome()</TD></TR></TABLE>>];
WaypointFileFlightController [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#DDEBFF"><TR><TD ALIGN="CENTER"><B>WaypointFileFlightController</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- planFile : Path</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ name()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ arm()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ takeOff(altitudeMeters)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ goTo(target, altitudeMeters)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ triggerPayload(command)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ returnToHome()</TD></TR></TABLE>>];
FlightException [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>FlightException</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- reason : FailureReason</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ reason() : FailureReason</TD></TR></TABLE>>];
FailureReason [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&laquo;enumeration&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>FailureReason</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">LINK_LOST</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">BATTERY_LOW</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">OUT_OF_BOUNDS</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PAYLOAD_FAULT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">COMMAND_REJECTED</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">STORAGE_ERROR</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">UNKNOWN</TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
PayloadCommand [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&laquo;enumeration&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>PayloadCommand</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">CAPTURE_PHOTO</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">SPRAY_ON</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">SPRAY_OFF</TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
}
subgraph cluster_adapter { label="package fieldwatch.adapter"; style="rounded,dashed"; color="#888888";
VendorDroneAdapter [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#DFF5DF"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&laquo;adapter&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>VendorDroneAdapter</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- FEET_PER_METER : double {static}</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- sdk : VendorDroneSdk</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ name()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ arm()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ takeOff(altitudeMeters)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ goTo(target, altitudeMeters)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ triggerPayload(command)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ returnToHome()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- execute(operation : String, call : Supplier&lt;SdkStatus&gt;)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- channelFor(command) : int {static}</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- reasonFor(vendorCode : int) : FailureReason {static}</TD></TR></TABLE>>];
}
subgraph cluster_vendor { label="package fieldwatch.vendor (third-party, unmodified)"; style="rounded,dashed"; color="#888888";
VendorDroneSdk [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EEEEEE"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&laquo;adaptee, third-party&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>VendorDroneSdk</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ OK, ERR_LINK_TIMEOUT, ERR_BATTERY_CRITICAL, ERR_GEOFENCE,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ ERR_PAYLOAD_JAM, ERR_BAD_CHANNEL, ERR_NOT_READY : int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ CH_SHUTTER, CH_SPRAY_OPEN, CH_SPRAY_CLOSE : int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- tailNumber : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- poweredOn, flying : boolean</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ tail() : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ powerOn() : SdkStatus</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ liftOff(heightFeet : int) : SdkStatus</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ navigate(altFeet : double, lon : double, lat : double) : SdkStatus</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ firePayload(channel : int) : SdkStatus</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ goHome() : SdkStatus</TD></TR></TABLE>>];
SdkStatus [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EEEEEE"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&laquo;third-party&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>SdkStatus</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- code : int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- detail : String</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ code() : int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ detail() : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ isOk() : boolean</TD></TR></TABLE>>];
}
subgraph cluster_geo { label="package fieldwatch.geo"; style="rounded,dashed"; color="#888888";
GeoPoint [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&laquo;record&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>GeoPoint</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">latitude : double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">longitude : double</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ parse(text : String) : GeoPoint {static}</TD></TR></TABLE>>];
FieldArea [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&laquo;record&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>FieldArea</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">southWest : GeoPoint</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">northEast : GeoPoint</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ heightMeters() : double</TD></TR></TABLE>>];
}
subgraph cluster_app { label="package fieldwatch.app  (runtime selection)"; style="rounded,dashed"; color="#888888";
Main [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>Main</B></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ main(args : String[]) {static}</TD></TR></TABLE>>];
MissionLauncher [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>MissionLauncher</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- controllers : NamedRegistry&lt;ControllerProvider&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- missions : NamedRegistry&lt;MissionProvider&gt;</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ launch(request : MissionRequest) : MissionReport</TD></TR></TABLE>>];
NamedRegistry [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>NamedRegistry&lt;T&gt;</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- kind : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- entries : Map&lt;String, T&gt;</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ register(key : String, entry : T) : NamedRegistry&lt;T&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ lookup(key : String) : T</TD></TR></TABLE>>];
ControllerProvider [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&laquo;interface&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>ControllerProvider</B></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ create(argument : String) : FlightController</TD></TR></TABLE>>];
MissionProvider [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&laquo;interface&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>MissionProvider</B></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ create(controller : FlightController) : FieldMission</TD></TR></TABLE>>];
MissionRequest [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&laquo;record&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>MissionRequest</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">missionType : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">controllerSpec : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">area : FieldArea</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ parse(line : String) : MissionRequest {static}</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ controllerScheme() : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ controllerArgument() : String</TD></TR></TABLE>>];
DefaultWiring [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&laquo;composition root&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>DefaultWiring</B></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ defaultControllers() : NamedRegistry&lt;ControllerProvider&gt; {static}</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ defaultMissions() : NamedRegistry&lt;MissionProvider&gt; {static}</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ defaultLauncher() : MissionLauncher {static}</TD></TR></TABLE>>];
UnknownSelectionException [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>UnknownSelectionException</B></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
}
FieldMission -> FlightController [dir=both, arrowtail=odiamond, arrowhead=vee, label="  controller  (the bridge)", fontsize=11, penwidth=2, color="#B8860B", fontcolor="#B8860B"];
MappingMission -> FieldMission [arrowhead=empty];
SprayingMission -> FieldMission [arrowhead=empty];
PerimeterPatrolMission -> FieldMission [arrowhead=empty];
SimulatorFlightController -> FlightController [style=dashed, arrowhead=empty];
WaypointFileFlightController -> FlightController [style=dashed, arrowhead=empty];
VendorDroneAdapter -> FlightController [style=dashed, arrowhead=empty, penwidth=2, color="#2E7D32"];
VendorDroneAdapter -> VendorDroneSdk [dir=both, arrowtail=odiamond, arrowhead=vee, label="  wraps  sdk", fontsize=11, penwidth=2, color="#2E7D32", fontcolor="#2E7D32"];
VendorDroneAdapter -> SdkStatus [style=dashed, arrowhead=vee, label="  translates", fontsize=10];
VendorDroneSdk -> SdkStatus [style=dashed, arrowhead=vee, label="  returns", fontsize=10];
FlightController -> FlightException [style=dashed, arrowhead=vee, label="  throws", fontsize=10];
FlightException -> FailureReason [arrowhead=vee];
FlightController -> PayloadCommand [style=dashed, arrowhead=vee];
FlightController -> GeoPoint [style=dashed, arrowhead=vee];
FieldMission -> MissionReport [style=dashed, arrowhead=vee, label="  creates", fontsize=10];
FieldMission -> FieldArea [style=dashed, arrowhead=vee];
MappingMission -> LawnmowerPlanner [style=dashed, arrowhead=vee];
SprayingMission -> LawnmowerPlanner [style=dashed, arrowhead=vee];
LawnmowerPlanner -> FieldArea [style=dashed, arrowhead=vee];
MissionReport -> MissionStatus [arrowhead=vee];
MissionReport -> FailureReason [arrowhead=vee];
FieldArea -> GeoPoint [dir=both, arrowtail=diamond, arrowhead=vee, headlabel="2", labeldistance=1.5, fontsize=10];
Main -> MissionLauncher [style=dashed, arrowhead=vee];
Main -> MissionRequest [style=dashed, arrowhead=vee];
Main -> DefaultWiring [style=dashed, arrowhead=vee];
MissionLauncher -> NamedRegistry [dir=both, arrowtail=odiamond, arrowhead=vee, headlabel="2", labeldistance=1.5, fontsize=10];
NamedRegistry -> ControllerProvider [style=dashed, arrowhead=vee, label="  T =", fontsize=9];
NamedRegistry -> MissionProvider [style=dashed, arrowhead=vee, label="  T =", fontsize=9];
MissionLauncher -> MissionRequest [style=dashed, arrowhead=vee];
MissionLauncher -> MissionReport [style=dashed, arrowhead=vee];
NamedRegistry -> UnknownSelectionException [style=dashed, arrowhead=vee, label="  throws", fontsize=10];
ControllerProvider -> FlightController [style=dashed, arrowhead=vee, label="  creates", fontsize=10];
MissionProvider -> FieldMission [style=dashed, arrowhead=vee, label="  creates", fontsize=10];
MissionProvider -> FlightController [style=dashed, arrowhead=vee];
MissionRequest -> FieldArea [arrowhead=vee];
DefaultWiring -> NamedRegistry [style=dashed, arrowhead=vee, label="  registers providers for\nSimulator, WaypointFile, VendorDroneAdapter,\nMapping, Spraying, PerimeterPatrol", fontsize=9];
DefaultWiring -> MissionLauncher [style=dashed, arrowhead=vee];
}